# Required: Anthropic API key for the explain backend.
# Get one at https://console.anthropic.com/. Keep this server-side only —
# it is never sent to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Claude model (default: claude-sonnet-4-6).
# CLAUDE_MODEL=claude-sonnet-4-6

# Optional: API server port (default: 8787). The Vite dev server proxies
# /api to this port.
# PORT=8787
