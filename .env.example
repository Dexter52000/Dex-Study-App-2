# Required: Anthropic API key for the explain backend.
# Get one at https://console.anthropic.com/. Keep this server-side only —
# it is never sent to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Claude model (default: claude-sonnet-4-6).
# CLAUDE_MODEL=claude-sonnet-4-6

# Optional: API server port (default: 8787). The Vite dev server proxies
# /api to this port.
# PORT=8787

# Optional: image generation for real-life illustrations. If OPENAI_API_KEY is
# unset, the app simply shows the text example (graceful degrade).
# OPENAI_API_KEY=sk-...
# IMAGE_MODEL=gpt-image-1        # or a cheaper/newer image model
# IMAGE_QUALITY=medium           # low | medium | high
# IMAGE_SIZE=1024x1024
# IMAGE_PROVIDER=openai          # set to "none" to disable image generation
